{
  "name": "Imagicruise – Reiseberichte",
  "short_name": "Imagicruise",
  "description": "Die Tage einer Reise mit allen Ereignissen und Fotos festhalten und als Reisebericht zeigen.",
  "lang": "de",
  "id": "./",
  "start_url": "./studio/",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#f3f4fb",
  "theme_color": "#312e81",
  "share_target": {
    "action": "./geteilt",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": { "files": [{ "name": "dateien", "accept": ["image/jpeg", "image/png", "image/webp", "application/zip", ".jpg", ".jpeg", ".png", ".webp", ".zip"] }] }
  },
  "icons": [
    { "src": "studio/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "studio/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "studio/icons/icon-maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "studio/icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ]
}
